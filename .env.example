# Copy to .env.local and fill in. Never commit real values.

# Admin panel login (/admin)
ADMIN_PASSWORD=change-me
# Long random string; signs admin session cookies
ADMIN_SECRET=

# MongoDB — website content + enquiries (empty = local files in /content)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGODB_DB=mahadev_overseas

# Cloudflare R2 — admin image uploads (empty = /content/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.yourdomain.com

# Optional: load video frames from R2/Cloudflare CDN (after `npm run frames:upload`)
NEXT_PUBLIC_FRAMES_BASE_URL=
